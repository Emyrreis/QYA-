"""Serviço de Notificações — pacote principal da aplicação."""

__version__ = "1.0.0"
"""Configuração central da aplicação.

Carrega variáveis de ambiente (e do arquivo `.env`) usando pydantic-settings.
Manter tudo aqui evita espalhar `os.getenv(...)` pelo código e dá validação
de tipos de graça.
"""

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Configurações da aplicação lidas do ambiente / arquivo .env."""

    app_name: str = "Serviço de Notificações"
    app_version: str = "1.0.0"
    environment: str = "development"

    # Broker do Celery. Em dev usamos Redis; em prod, RabbitMQ.
    celery_broker_url: str = "redis://localhost:6379/0"
    celery_result_backend: str = "redis://localhost:6379/0"

    # Se True, usa Celery de verdade. Se False, processa em background
    # task do próprio FastAPI (útil para rodar local sem broker e nos testes).
    use_celery: bool = False

    # Limite simples de mensagens por destinatário (anti-spam).
    rate_limit_per_recipient: int = 5

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore",
    )


@lru_cache
def get_settings() -> Settings:
    """Retorna uma instância única (cacheada) das configurações.

    O `lru_cache` garante que o arquivo `.env` seja lido só uma vez.
    """
    return Settings()
"""Modelos (schemas) Pydantic v2.

Estes modelos definem o contrato da API: o que entra (`NotificationCreate`),
o que sai (`NotificationRead`) e os tipos auxiliares (enums). A validação
acontece automaticamente — se o cliente mandar um payload inválido, o FastAPI
responde 422 sem o código de negócio nem ser executado.
"""

from __future__ import annotations

import re
from datetime import datetime, timezone
from enum import Enum
from uuid import UUID, uuid4

from pydantic import BaseModel, ConfigDict, EmailStr, Field, model_validator


class NotificationType(str, Enum):
    """Canal de envio da notificação."""

    EMAIL = "email"
    SMS = "sms"


class NotificationStatus(str, Enum):
    """Ciclo de vida de uma notificação."""

    PENDING = "pending"   # criada, ainda na fila
    SENT = "sent"         # enviada com sucesso (mock)
    FAILED = "failed"     # falhou no envio


# Regex simples para telefone em formato internacional: +5511999998888
_PHONE_RE = re.compile(r"^\+?[1-9]\d{7,14}$")


class NotificationCreate(BaseModel):
    """Payload de entrada para criar uma notificação."""

    event_type: str = Field(
        ...,
        min_length=1,
        max_length=100,
        examples=["nova_reserva"],
        description="Evento de negócio que disparou a notificação.",
    )
    recipient: str = Field(
        ...,
        examples=["usuario@email.com"],
        description="E-mail ou telefone do destinatário, conforme o tipo.",
    )
    notification_type: NotificationType = Field(
        ...,
        description="Canal de envio: email ou sms.",
    )
    message: str = Field(
        ...,
        min_length=1,
        max_length=1000,
        examples=["Sua reserva foi confirmada!"],
    )

    @model_validator(mode="after")
    def validate_recipient_matches_type(self) -> "NotificationCreate":
        """Garante que o destinatário casa com o canal escolhido.

        - email  -> precisa ser um e-mail válido
        - sms    -> precisa ser um telefone válido
        Validar aqui (e não só no service) significa que dados inválidos
        nunca chegam à lógica de negócio.
        """
        if self.notification_type is NotificationType.EMAIL:
            # Reaproveita o validador de e-mail do Pydantic.
            try:
                EmailStr._validate(self.recipient)  # type: ignore[attr-defined]
            except Exception as exc:  # noqa: BLE001
                raise ValueError(
                    "recipient deve ser um e-mail válido para notification_type=email"
                ) from exc
        elif self.notification_type is NotificationType.SMS:
            if not _PHONE_RE.match(self.recipient):
                raise ValueError(
                    "recipient deve ser um telefone válido (ex: +5511999998888) "
                    "para notification_type=sms"
                )
        return self


class NotificationRead(BaseModel):
    """Representação de saída de uma notificação."""

    model_config = ConfigDict(from_attributes=True)

    id: UUID
    event_type: str
    recipient: str
    notification_type: NotificationType
    message: str
    status: NotificationStatus
    created_at: datetime
    updated_at: datetime


class Notification(BaseModel):
    """Entidade de domínio armazenada no repositório.

    Difere do `NotificationCreate` porque carrega estado: id, status e
    timestamps. É o objeto que vive no banco/store.
    """

    id: UUID = Field(default_factory=uuid4)
    event_type: str
    recipient: str
    notification_type: NotificationType
    message: str
    status: NotificationStatus = NotificationStatus.PENDING
    created_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))
    updated_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))

    def mark(self, status: NotificationStatus) -> None:
        """Atualiza o status e o carimbo de tempo."""
        self.status = status
        self.updated_at = datetime.now(timezone.utc)
"""Repositório de notificações.

Abstrai *onde* os dados ficam guardados. Aqui usamos um dicionário em memória
protegido por lock (thread-safe), que é o suficiente para um case acadêmico.

A vantagem de isolar isso atrás de uma classe é que, se um dia quisermos trocar
por PostgreSQL ou Redis, só esta camada muda — service, routers e testes
continuam iguais.
"""

from __future__ import annotations

import threading
from uuid import UUID

from app.models.schemas import Notification


class NotificationRepository:
    """Armazenamento em memória, seguro para acesso concorrente."""

    def __init__(self) -> None:
        self._items: dict[UUID, Notification] = {}
        self._lock = threading.Lock()

    def add(self, notification: Notification) -> Notification:
        with self._lock:
            self._items[notification.id] = notification
        return notification

    def get(self, notification_id: UUID) -> Notification | None:
        with self._lock:
            return self._items.get(notification_id)

    def list_all(self) -> list[Notification]:
        with self._lock:
            # Ordena do mais recente para o mais antigo.
            return sorted(
                self._items.values(),
                key=lambda n: n.created_at,
                reverse=True,
            )

    def count_for_recipient(self, recipient: str) -> int:
        with self._lock:
            return sum(1 for n in self._items.values() if n.recipient == recipient)

    def clear(self) -> None:
        """Usado principalmente nos testes para isolar cada caso."""
        with self._lock:
            self._items.clear()


# Instância única (singleton de módulo) usada pela aplicação em runtime.
repository = NotificationRepository()

"""Lógica de negócio do serviço de notificações.

Esta camada não sabe nada sobre HTTP (FastAPI) nem sobre fila (Celery).
Ela só conhece o domínio: criar notificação, aplicar regras (rate limit),
"enviar" pelo canal certo e atualizar o status. Por isso é a parte mais
fácil de testar unitariamente.

Os envios de e-mail e SMS são *mockados*: não saem mensagens reais, apenas
logamos. Em produção, trocaríamos `_send_email` / `_send_sms` por chamadas a
provedores reais (SendGrid, Twilio, etc.).
"""

from __future__ import annotations

import logging
from uuid import UUID

from app.models.schemas import (
    Notification,
    NotificationCreate,
    NotificationStatus,
    NotificationType,
)
from app.repository.store import NotificationRepository, repository

logger = logging.getLogger(__name__)


class RateLimitExceededError(Exception):
    """Disparada quando um destinatário ultrapassa o limite de mensagens."""


class NotificationService:
    """Orquestra criação, envio e consulta de notificações."""

    def __init__(
        self,
        repo: NotificationRepository | None = None,
        rate_limit: int = 5,
    ) -> None:
        # Injeção de dependência: nos testes passamos um repo limpo.
        self.repo = repo or repository
        self.rate_limit = rate_limit

    # ----------------------- Casos de uso públicos ----------------------- #

    def create(self, payload: NotificationCreate) -> Notification:
        """Cria e persiste uma notificação no estado PENDING.

        Aplica o rate limit antes de aceitar. O envio em si é disparado
        separadamente (em background), por isso aqui ela nasce PENDING.
        """
        self._enforce_rate_limit(payload.recipient)

        notification = Notification(
            event_type=payload.event_type,
            recipient=payload.recipient,
            notification_type=payload.notification_type,
            message=payload.message,
        )
        self.repo.add(notification)
        logger.info("Notificação criada id=%s tipo=%s", notification.id,
                    notification.notification_type.value)
        return notification

    def get(self, notification_id: UUID) -> Notification | None:
        return self.repo.get(notification_id)

    def list_all(self) -> list[Notification]:
        return self.repo.list_all()

    def deliver(self, notification_id: UUID) -> Notification | None:
        """Executa o envio (mock) e atualiza o status para SENT ou FAILED.

        É este método que roda em background (BackgroundTasks ou Celery).
        """
        notification = self.repo.get(notification_id)
        if notification is None:
            logger.warning("deliver: notificação %s não encontrada", notification_id)
            return None

        try:
            if notification.notification_type is NotificationType.EMAIL:
                self._send_email(notification.recipient, notification.message)
            else:
                self._send_sms(notification.recipient, notification.message)
            notification.mark(NotificationStatus.SENT)
            logger.info("Notificação %s enviada com sucesso", notification.id)
        except Exception:  # noqa: BLE001
            notification.mark(NotificationStatus.FAILED)
            logger.exception("Falha ao enviar notificação %s", notification.id)

        return notification

    # --------------------------- Regras internas ------------------------- #

    def _enforce_rate_limit(self, recipient: str) -> None:
        if self.repo.count_for_recipient(recipient) >= self.rate_limit:
            raise RateLimitExceededError(
                f"Limite de {self.rate_limit} mensagens atingido para {recipient}"
            )

    # --------------------------- Envios (mock) ---------------------------- #

    @staticmethod
    def _send_email(recipient: str, message: str) -> None:
        # Mock: aqui entraria a integração real (SMTP / SendGrid).
        logger.info("[MOCK EMAIL] para=%s | %s", recipient, message)

    @staticmethod
    def _send_sms(recipient: str, message: str) -> None:
        # Privacidade: NÃO logamos o número completo, só os últimos 4 dígitos.
        masked = f"****{recipient[-4:]}" if len(recipient) >= 4 else "****"
        logger.info("[MOCK SMS] para=%s | %s", masked, message)
"""Tasks Celery para envio assíncrono.

Em produção, a API só enfileira: o Celery worker consome a fila e chama o
service. Em dev/testes mantemos `use_celery=False` e processamos com as
BackgroundTasks do próprio FastAPI, evitando precisar de um broker rodando.
"""

from __future__ import annotations

from uuid import UUID

from celery import Celery

from app.config import get_settings
from app.services.notification_service import NotificationService

settings = get_settings()

celery_app = Celery(
    "notifications",
    broker=settings.celery_broker_url,
    backend=settings.celery_result_backend,
)
celery_app.conf.update(
    task_serializer="json",
    accept_content=["json"],
    result_serializer="json",
    timezone="UTC",
    enable_utc=True,
)


@celery_app.task(name="notifications.deliver")
def deliver_notification_task(notification_id: str) -> str:
    """Task que executa o envio de uma notificação pelo seu ID."""
    service = NotificationService(rate_limit=settings.rate_limit_per_recipient)
    result = service.deliver(UUID(notification_id))
    return result.status.value if result else "not_found"
"""Endpoint de health check.

Usado por orquestradores (Docker, Kubernetes) e pelo Quality Gate dos testes
para saber se a aplicação está de pé.
"""

from fastapi import APIRouter

from app.config import get_settings

router = APIRouter(tags=["health"])


@router.get("/health", summary="Health check")
def health() -> dict[str, str]:
    settings = get_settings()
    return {
        "status": "ok",
        "service": settings.app_name,
        "version": settings.app_version,
        "environment": settings.environment,
    }
"""Endpoints de notificação.

A camada HTTP: recebe a requisição, delega para o `NotificationService` e
traduz o resultado em respostas HTTP corretas (201, 200, 404, 429...).
O envio é agendado em background para a API responder rápido (assíncrono).
"""

from __future__ import annotations

from uuid import UUID

from fastapi import APIRouter, BackgroundTasks, Depends, HTTPException, status

from app.config import Settings, get_settings
from app.models.schemas import NotificationCreate, NotificationRead
from app.services.notification_service import (
    NotificationService,
    RateLimitExceededError,
)

router = APIRouter(prefix="/notifications", tags=["notifications"])


def get_service(settings: Settings = Depends(get_settings)) -> NotificationService:
    """Dependência que fornece o service configurado.

    Centralizar a criação aqui permite sobrescrever (override) nos testes.
    """
    return NotificationService(rate_limit=settings.rate_limit_per_recipient)


@router.post(
    "/",
    response_model=NotificationRead,
    status_code=status.HTTP_201_CREATED,
    summary="Cria e enfileira uma notificação",
)
def create_notification(
    payload: NotificationCreate,
    background_tasks: BackgroundTasks,
    settings: Settings = Depends(get_settings),
    service: NotificationService = Depends(get_service),
) -> NotificationRead:
    try:
        notification = service.create(payload)
    except RateLimitExceededError as exc:
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail=str(exc),
        ) from exc

    # Dispara o envio em background sem travar a resposta.
    if settings.use_celery:
        from app.workers.tasks import deliver_notification_task

        deliver_notification_task.delay(str(notification.id))
    else:
        background_tasks.add_task(service.deliver, notification.id)

    return NotificationRead.model_validate(notification)


@router.get(
    "/",
    response_model=list[NotificationRead],
    summary="Lista todas as notificações",
)
def list_notifications(
    service: NotificationService = Depends(get_service),
) -> list[NotificationRead]:
    return [NotificationRead.model_validate(n) for n in service.list_all()]


@router.get(
    "/{notification_id}",
    response_model=NotificationRead,
    summary="Consulta uma notificação por ID",
)
def get_notification(
    notification_id: UUID,
    service: NotificationService = Depends(get_service),
) -> NotificationRead:
    notification = service.get(notification_id)
    if notification is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Notificação não encontrada",
        )
    return NotificationRead.model_validate(notification)
"""Ponto de entrada da aplicação FastAPI.

Cria a instância do app, configura logging e registra os routers.
Rode com:  uvicorn app.main:app --reload
Docs em:   http://localhost:8000/docs
"""

from __future__ import annotations

import logging

from fastapi import FastAPI

from app.config import get_settings
from app.routers import health, notifications

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
)

settings = get_settings()

app = FastAPI(
    title=settings.app_name,
    version=settings.app_version,
    description=(
        "API assíncrona para disparo de notificações por E-mail e SMS. "
        "Construída com FastAPI + Celery + Redis/RabbitMQ."
    ),
)

app.include_router(health.router)
app.include_router(notifications.router)


@app.get("/", tags=["root"], summary="Raiz")
def root() -> dict[str, str]:
    return {
        "message": f"{settings.app_name} no ar",
        "docs": "/docs",
        "health": "/health",
    }
